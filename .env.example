# ---- Azure OpenAI (Microsoft Foundry) -- create in swedencentral ----
# Endpoint looks like https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Confirm this against the "sample code" panel of your deployment in the portal.
AZURE_OPENAI_API_VERSION=2024-10-21
# These are DEPLOYMENT names you choose, not model names.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
# 1536 is native, but 2,914 docs at 1536 dims exceeded the Free tier's
# 50 MB. 512 is the documented reduction and leaves room to grow the corpus.
EMBEDDING_DIMENSIONS=512

# ---- Azure AI Search -- create in canadacentral (semantic ranker on Free) ----
# Endpoint looks like https://<service-name>.search.windows.net
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=kotoba-grammar
# Set false on a Free-tier service if the semantic ranker probe fails.
AZURE_SEARCH_SEMANTIC_ENABLED=true
